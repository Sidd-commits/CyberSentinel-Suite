{
  "manifest_version": 3,
  "name": "Phishing URL Detector",
  "version": "3.0",
  "description": "Real-time phishing detection — logs every URL you visit to your local dashboard.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "notifications",
    "webNavigation"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing URL Detector"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
